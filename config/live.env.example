# Account identifiers and a protected LOCAL key-file path; no signing-key value.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_SIGNING_KEY_FILE=/etc/apexmind/signing.key

# Select a real, locally produced evaluation after successful calibration.
APEX_CONFIG=/etc/apexmind/config.toml
APEX_REPORT=/var/lib/apexmind/evaluation/report.json
APEX_MODEL=/var/lib/apexmind/evaluation/champion.joblib
APEX_LATENCY=/var/lib/apexmind/latency.json
APEX_REGISTRY=/var/lib/apexmind/laboratory/registry.json
# Set pilot explicitly to collect forward evidence; production requires proof.
APEX_STAGE=production
