[Unit]
Description=APEX MIND native execution and exposure watchdog
Wants=network-online.target
After=network-online.target chrony.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=apexmind
Group=apexmind
WorkingDirectory=/opt/apexmind
EnvironmentFile=/etc/apexmind/live.env
EnvironmentFile=-/etc/apexmind/network.env
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
ExecStartPre=/opt/apexmind/.venv/bin/apex --config ${APEX_CONFIG} recover --timeout 120
ExecStart=/opt/apexmind/.venv/bin/apex --config ${APEX_CONFIG} live --report ${APEX_REPORT} --model ${APEX_MODEL} --latency ${APEX_LATENCY} --stage ${APEX_STAGE} --registry ${APEX_REGISTRY}
ExecStopPost=/opt/apexmind/.venv/bin/apex --config ${APEX_CONFIG} recover --timeout 120
Restart=on-failure
RestartSec=30
TimeoutStartSec=180
TimeoutStopSec=180
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apexmind
UMask=0077

[Install]
WantedBy=multi-user.target
